@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
hide methods
hide circle
title SysML BDD - definitions, composition and flow interfaces
class "SmartTrafficLightSystem\nBLK-01" as System <<block>>
class "VehicleDetection\nBLK-02" as Sensor <<block>> {
 samplesOut : SamplesIF
 statusOut : StatusIF
}
class "DensityAnalysis\nBLK-03" as Analysis <<block>> {
 samplesIn : ~SamplesIF
 densityOut : DensityIF
}
class "TrafficController\nBLK-04" as Controller <<block>> {
 densityIn : ~DensityIF
 statusIn : ~StatusIF
 commandOut : CommandIF
 boundaryIn : ~BoundaryIF
 eligible : Approach[0..4]
 mode : ControlMode
 minimumGreen = 10 s
 maximumGreen = 30 s
 maximumWaitingTime = 210 s
}
class "SignalController\nBLK-05" as Signals <<block>> {
 commandIn : ~CommandIF
 boundaryOut : BoundaryIF
 lampsOut : LampsIF
 lifecycle : STM-01
}
class "TrafficLights\nBLK-06" as Lights <<block>> {
 lampsIn : ~LampsIF
 approach : Approach
}
System "1" *-- "1" Sensor : sensor
System "1" *-- "1" Analysis : analysis
System "1" *-- "1" Controller : controller
System "1" *-- "1" Signals : signals
System "1" *-- "4" Lights : lights
Sensor -[hidden]down-> Controller
Analysis -[hidden]down-> Signals
note bottom of Controller
Port declarations shown in block compartment.
Receiver uses conjugated interface (~).
Value types and all port endpoints are defined
in the traceability model dictionary.
end note
@enduml
