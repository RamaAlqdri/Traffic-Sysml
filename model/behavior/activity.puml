@startuml
skinparam shadowing false
title SysML activity view - ACT-00 ManageTraffic
start
 :ACT-10 Startup all-red 1 s;
while (system running?) is (yes)
 :Accept sample, observation tick, or phase timer event;
 if (sample or observation tick?) then (yes)
   :ACT-01 Validate frame/cache and update\ndataFault + recovery streak;\nclear dataFault after 3 new good frames;
  if (complete fresh valid cache?) then (yes)
    :ACT-02 Classify fresh valid counts;
  endif
 endif
  :ACT-05 Advance granted phase timer;
 if (safe boundary at tick?) then (yes)
   :ACT-07 Select Normal/Fallback mode;\nrecovery only at new round;
   :ACT-03 Refresh eligible at new round;\nrank eligible and check deadlines;
   if (feasible plan?) then (yes)
    :ACT-04 Prepare frozen green grant;
   else (no)
    :Request SafetyHold all-red;
    stop
   endif
   :ACT-09 Validate and apply grant\nthen emit grantAccepted(i);
   :ACT-08 On grantAccepted:\nmark served and advance pointer;
 endif
  :ACT-06 Perform only enabled STM-01 transition:\ngreen expiry -> yellow3; yellow expiry -> all-red1;\nclearance expiry -> Ready; otherwise stay;
endwhile (no)
stop
@enduml
